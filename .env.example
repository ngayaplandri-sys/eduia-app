# ─────────────────────────────────────────────────────────────
# EduIA — variables d'environnement (MODÈLE, sans aucune vraie valeur)
# Copie ce fichier en `.env.local` (local) et renseigne les valeurs ;
# en production, saisis-les dans Vercel → Settings → Environment Variables.
# Next.js ne lit JAMAIS ce fichier : n'y mets aucune vraie clé.
# ─────────────────────────────────────────────────────────────

# URL publique du site (utilisée pour les métadonnées / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Base de données : Neon (PostgreSQL) ──
# Copier depuis le tableau de bord Neon → Connection Details.
DATABASE_URL=postgresql://your_db_user:your_db_password@your-host-pooler.neon.tech/your_db_name?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://your_db_user:your_db_password@your-host.neon.tech/your_db_name?sslmode=require

# ── Authentification : Better Auth (auto-hébergé) ──
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Compte de démonstration semé par `npm run db:seed`
DEMO_USER_EMAIL=demo@eduia.app
DEMO_USER_PASSWORD=your_demo_password_here

# ── Connexion Google (OAuth 2.0) ──
# Créer des identifiants sur https://console.cloud.google.com/apis/credentials
# (type « Application Web »). Ajouter comme URI de redirection autorisé :
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://<ton-domaine>/api/auth/callback/google    (prod)
# Le bouton « Continuer avec Google » reste masqué tant que ces deux valeurs
# sont vides.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── IA : OpenAI (Résumer / Générer / Corriger) ──
# Clé secrète créée sur https://platform.openai.com/api-keys — jamais exposée au client
# (utilisée uniquement dans lib/ai/* et app/api/ai/*, protégés par `server-only`).
OPENAI_API_KEY=your_openai_api_key_here
# Modèle utilisé pour les 3 générations (ajustable sans changer le code).
OPENAI_MODEL=gpt-5.4-mini

# ── Paiement : Maketou (abonnements Premium + recharges) ──
# Guide complet : docs/PAIEMENT-MAKETOU.md. Une valeur par ligne, commentaires
# sur leur propre ligne, sans guillemets ni espaces.
# Clé API de la boutique Maketou (Autres > Clés API)
MAKETOU_API_KEY=your_maketou_api_key_here
# Identifiant public de chaque produit (Produit > Partager)
MAKETOU_PRODUCT_PREMIUM=your_premium_product_id
MAKETOU_PRODUCT_PREMIUM_PLUS=your_premium_plus_product_id
MAKETOU_PRODUCT_RECHARGE_100=your_recharge_100_product_id
MAKETOU_PRODUCT_RECHARGE_250=your_recharge_250_product_id
MAKETOU_PRODUCT_RECHARGE_500=your_recharge_500_product_id
MAKETOU_PRODUCT_RECHARGE_1000=your_recharge_1000_product_id
# Adresse publique exacte du site (https://, sans / final) — à défaut BETTER_AUTH_URL
APP_URL=https://your-domain.example
# Secret du rapprochement planifié (toutes les 5 min) et de la route de contrôle.
# La valeur SEULE, sans le mot « Bearer » (ce préfixe va uniquement dans
# l'en-tête Authorization configuré sur cron-job.org).
CRON_SECRET=your_long_random_cron_secret_here
# Facultatif : offre de test réservée aux admins (produit à petit prix, en XAF)
MAKETOU_PRODUCT_TEST=
MAKETOU_TEST_PRICE=

# ── Facultatif ──
# `true` = crédits illimités pour les comptes admin (laisser vide en production).
ADMIN_UNLIMITED_CREDITS=
